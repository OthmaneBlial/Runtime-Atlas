# Runtime Atlas binds to loopback by default. Set HOST=0.0.0.0 only inside a
# trusted container/network or behind a properly configured reverse proxy.
HOST=127.0.0.1
PORT=4319
NODE_ENV=production

ATLAS_PROJECT_NAME=meridian-commerce-demo
ATLAS_ENVIRONMENT=local
# Comma-separated TypeScript globs. Leave empty to use the built-in demo.
# ATLAS_SOURCE_GLOB=../orders-api/src/**/*.ts

# Required for untrusted or shared ingest networks. Minimum 16 characters.
# ATLAS_INGEST_TOKEN=replace-with-a-long-random-value

ATLAS_EXPOSE_SOURCE=true
ATLAS_ALLOW_CLEAR=true
ATLAS_TRUST_PROXY=false
ATLAS_LOG_LEVEL=info

ATLAS_OTLP_BODY_LIMIT=8mb
ATLAS_OTLP_MAX_SPANS=1000
ATLAS_OTLP_MAX_CONCURRENT_REQUESTS=16
ATLAS_INGEST_RATE_LIMIT=600
ATLAS_DEMO_RATE_LIMIT=120

ATLAS_MAX_TRACES=60
ATLAS_MAX_BUFFERED_EVENTS=800
ATLAS_MAX_EVENTS_PER_TRACE=5000
ATLAS_MAX_RETAINED_EVENTS=50000
ATLAS_MAX_STREAM_CLIENTS=100
ATLAS_TOPOLOGY_CACHE_MS=2000
ATLAS_SHUTDOWN_TIMEOUT_MS=10000
