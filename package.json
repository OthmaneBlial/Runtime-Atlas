{
  "name": "runtime-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Replay Node.js requests on a live architecture map linked back to TypeScript source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/Runtime-Atlas.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/Runtime-Atlas/issues"
  },
  "homepage": "https://othmaneblial.github.io/Runtime-Atlas/",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n atlas,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build:sdk": "npm run build --workspace @runtime-atlas/sdk",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build": "npm run build:sdk && npm run build:server && tsc -b && vite build",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:site": "node scripts/test-site.mjs",
    "typecheck": "npm run build:sdk && tsc -b",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check:repo": "node scripts/check-repository.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:sdk-package": "npm pack --dry-run --workspace @runtime-atlas/sdk",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "smoke": "node scripts/smoke-production.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e:run && npm run test:site && npm run check:repo && npm run check:site && npm run check:docs && npm run check:sdk-package && npm run smoke"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.33.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "request-debugging",
    "runtime",
    "service-map",
    "source-code",
    "tracing",
    "typescript",
    "visualization"
  ]
}
